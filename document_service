"""
Document Service for uploading and querying PDF/Word documents.
Extracts text from uploaded files and stores them in memory for Q&A.
"""

import io
import uuid
import logging
from datetime import datetime
from typing import Optional, Dict, Any, List

logger = logging.getLogger(__name__)


def extract_text_from_pdf(file_bytes: bytes) -> str:
    from PyPDF2 import PdfReader
    reader = PdfReader(io.BytesIO(file_bytes))
    pages = []
    for page in reader.pages:
        text = page.extract_text()
        if text:
            pages.append(text)
    return "\n\n".join(pages)


def extract_text_from_docx(file_bytes: bytes) -> str:
    from docx import Document
    doc = Document(io.BytesIO(file_bytes))
    paragraphs = [p.text for p in doc.paragraphs if p.text.strip()]
    return "\n\n".join(paragraphs)


class StoredDocument:
    """Represents an uploaded document with extracted text."""

    def __init__(self, doc_id: str, filename: str, text: str, file_size: int):
        self.doc_id = doc_id
        self.filename = filename
        self.text = text
        self.file_size = file_size
        self.uploaded_at = datetime.utcnow().isoformat()
        self.char_count = len(text)

    def to_metadata(self) -> Dict[str, Any]:
        return {
            "doc_id": self.doc_id,
            "filename": self.filename,
            "file_size": self.file_size,
            "char_count": self.char_count,
            "uploaded_at": self.uploaded_at,
        }


class DocumentStore:
    """In-memory store for uploaded documents."""

    def __init__(self):
        self._documents: Dict[str, StoredDocument] = {}

    def add_document(self, filename: str, file_bytes: bytes) -> StoredDocument:
        ext = filename.rsplit(".", 1)[-1].lower() if "." in filename else ""
        if ext == "pdf":
            text = extract_text_from_pdf(file_bytes)
        elif ext in ("docx", "doc"):
            text = extract_text_from_docx(file_bytes)
        else:
            raise ValueError(f"Unsupported file type: .{ext}. Upload a PDF or Word (.docx) file.")

        if not text.strip():
            raise ValueError("Could not extract any text from the file.")

        doc_id = str(uuid.uuid4())[:8]
        doc = StoredDocument(doc_id=doc_id, filename=filename, text=text, file_size=len(file_bytes))
        self._documents[doc_id] = doc
        logger.info(f"Document stored: {filename} ({doc.char_count} chars, id={doc_id})")
        return doc

    def get_document(self, doc_id: str) -> Optional[StoredDocument]:
        return self._documents.get(doc_id)

    def list_documents(self) -> List[Dict[str, Any]]:
        return [doc.to_metadata() for doc in self._documents.values()]

    def delete_document(self, doc_id: str) -> bool:
        if doc_id in self._documents:
            del self._documents[doc_id]
            return True
        return False


# Global singleton
_document_store: Optional[DocumentStore] = None


def get_document_store() -> DocumentStore:
    global _document_store
    if _document_store is None:
        _document_store = DocumentStore()
    return _document_store
