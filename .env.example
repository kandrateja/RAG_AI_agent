# ============================================
# RAG AI Agent - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# AWS BEDROCK CONFIGURATION (Required)
# Claude Sonnet 4 for LLM and Vision
# ============================================
USE_BEDROCK_LLM=true
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# ============================================
# AWS TITAN EMBEDDINGS (Required)
# V1 (amazon.titan-embed-image-v1): Multimodal (text + image), English only
# V2 (amazon.titan-embed-text-v2:0): Text only, Multilingual (100+ languages)
# Hybrid: Use V2 for text (native multilingual), V1 for images
# ============================================
USE_TITAN_EMBEDDINGS=true
TITAN_EMBEDDING_MODEL_ID=amazon.titan-embed-image-v1
# Set to true for native Arabic support (no translation needed)
USE_TITAN_V2_FOR_TEXT=true

# ============================================
# NEO4J GRAPH DATABASE (Required)
# ============================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=rag-neo4j-password-2024
NEO4J_DATABASE=neo4j

# ============================================
# POSTGRESQL + PGVECTOR (Required)
# ============================================
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/rag

# ============================================
# WEB SEARCH - SERPAPI (Required)
# Get your API key from: https://serpapi.com/
# ============================================
SURF_API_ENDPOINT=https://serpapi.com/search.json
SURF_API_KEY=your-serpapi-key
SURF_MAX_RESULTS=5

# ============================================
# AZURE OPENAI (Optional - Not used by default)
# Only used if USE_BEDROCK_LLM=false
# ============================================
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=

# ============================================
# INGESTION SETTINGS
# ============================================
# Pipeline hint: auto | standard | arabic | handwritten
INGESTION_PIPELINE_HINT=auto
# Min page text length below which vision fallback is used
INGESTION_VISION_FALLBACK_MIN_CHARS=50

# ============================================
# ARABIC / MULTILINGUAL SETTINGS
# ============================================
# If USE_TITAN_V2_FOR_TEXT=true, these are not needed (V2 is multilingual)
# Only used when V2 is disabled (V1 requires translation for Arabic)
TRANSLATE_ARABIC_FOR_EMBEDDING=true
# Use Arabic-specific sentence boundaries for better chunking
USE_ARABIC_SENTENCE_CHUNKING=true
# Optional: Cache directory for translations (default: ~/.cache/rag_translations)
# TRANSLATION_CACHE_DIR=/path/to/cache

# ============================================
# APPLICATION SETTINGS
# ============================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_TOKENS=4096
TEMPERATURE=0.7
